# supabase (Copiarlos de Supabase -> Settings -> API)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Cron Job Secret (genera un secreto aleatorio para seguridad)
CRON_SECRET=tu-secreto-aleatorio-aqui

# Tuya API (opcional: puedes configurarlo desde el panel admin)
# TUYA_CLIENT_ID=tu-client-id
# TUYA_CLIENT_SECRET=tu-client-secret
