{
    "crons": [
        {
            "path": "/api/cron-keep-alive",
            "schedule": "0 0 */5 * *"
        },
        {
            "path": "/api/cron-water-monitoring",
            "schedule": "*/30 * * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}